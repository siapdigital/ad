{
  "name": "RDP Windows Server Lab",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "runArgs": [
    "--device=/dev/kvm",
    "--device=/dev/net/tun",
    "--cap-add=NET_ADMIN"
  ],
  "overrideCommand": false,
  "postStartCommand": "/bin/bash .devcontainer/start-worker.sh > /tmp/worker.log 2>&1 &"
}
